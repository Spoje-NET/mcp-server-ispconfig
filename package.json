  "description": "MCP (Model Context Protocol) server for ISPConfig 3 \u2014 manage DNS, mail, sites, databases, and more via AI assistants",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-server-ispconfig": "dist/index.js",
